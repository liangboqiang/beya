{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beya.local/contracts/meta/module.schema.json",
  "title": "Beya Module Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "layer", "stability", "owns", "allowedDependencies"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "name": { "type": "string" },
    "layer": {
      "type": "string",
      "enum": ["access", "gateway", "session", "agent", "capability", "runtime", "foundation"]
    },
    "layerOrder": {
      "type": "integer",
      "minimum": 0
    },
    "stability": {
      "type": "string",
      "enum": ["experimental", "stable", "deprecated"]
    },
    "description": { "type": "string" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "array",
          "items": { "type": "string" }
        },
        "desktop": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contracts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "owns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "resourceMethods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$"
      }
    },
    "events": {
      "type": "array",
      "items": { "type": "string" }
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "path"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "path": { "type": "string" },
          "migrationRequired": { "type": "boolean" }
        }
      }
    },
    "allowedDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "forbiddenDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "implementationRoots": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
